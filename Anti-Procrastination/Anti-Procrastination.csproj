<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Anti_Procrastination</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <SelfContained>true</SelfContained>

    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <IlcDisableReflection>true</IlcDisableReflection>
    <StackTraceSupport>false</StackTraceSupport>
    <IlcGenerateMstatFile>true</IlcGenerateMstatFile>
    <IlcGenerateDgmlFile>true</IlcGenerateDgmlFile>
    <IlcGenerateMapFile>true</IlcGenerateMapFile>
    <IlcDumpGeneratedIL>true</IlcDumpGeneratedIL>   
	<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	<PlatformTarget>AnyCPU</PlatformTarget>
	<ApplicationIcon>favicon.ico</ApplicationIcon>
	<ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>


  <ItemGroup> 
  <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
  <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.7" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.IO.Pipes" Version="4.3.0" />
  </ItemGroup>


  <ItemGroup>
    <EditorConfigFiles Remove="C:\Users\Rozere1\Anti-Procrastination\AntiProcrastination\Anti-Procrastination\.editorconfig" />
  </ItemGroup>


  <ItemGroup>
    <Content Include="favicon.ico" />
  </ItemGroup>


  <ItemGroup>
    <None Include="C:\Users\Rozere1\Anti-Procrastination\AntiProcrastination\Anti-Procrastination\.editorconfig" />
  </ItemGroup>

</Project>
